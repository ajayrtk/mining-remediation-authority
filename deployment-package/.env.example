# ==================================================
# MRA Mines Map - Deployment Environment Configuration
# ==================================================
# Copy this file to .env and configure for your environment
# IMPORTANT: Never commit .env to version control!
# cp .env.example .env

# ==================================================
# AWS CREDENTIALS (REQUIRED)
# ==================================================
# Get these from your AWS IAM console
# IAM Console: https://console.aws.amazon.com/iam/
# Create a user with admin access or appropriate permissions

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2

# ==================================================
# PROCESSOR REPOSITORY (REQUIRED)
# ==================================================
# Set this to the absolute path where you extracted mra-mine-plans-ds
# Example on Linux/macOS: /home/username/mra-mine-plans-ds
# Example on Windows: C:/Users/username/mra-mine-plans-ds
PROCESSOR_REPO_PATH=

# ==================================================
# OPTIONAL: PROJECT CONFIGURATION
# ==================================================
# Uncomment to override defaults from terraform.tfvars
# PROJECT_NAME=mra-mines
# ENVIRONMENT=prod
